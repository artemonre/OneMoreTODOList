# Copy this file to keystore.properties (same directory) and fill in your real values.
# keystore.properties is gitignored - never commit real signing credentials.
#
# Generate a keystore first if you don't already have one, e.g.:
#   keytool -genkeypair -v -keystore release-keystore.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to this module's directory (gateway/todoList) unless you give an
# absolute path.
storeFile=release-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
