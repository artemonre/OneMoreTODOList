<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".TodoListApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QuickAddTodoActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.QuickAddTodo"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".widget.TodoWidgetReceiver"
            android:exported="true"
            android:label="@string/todo_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_info" />
        </receiver>

        <!-- Same TodoWidget, registered again with a smaller default placement size so it shows
             as its own separately pickable entry in the widget picker (see TodoWidgetCompactReceiver). -->
        <receiver
            android:name=".widget.TodoWidgetCompactReceiver"
            android:exported="true"
            android:label="@string/todo_widget_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_compact_info" />
        </receiver>

        <receiver
            android:name=".widget.TodoWidgetRowReceiver"
            android:exported="true"
            android:label="@string/todo_widget_row_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_row_info" />
        </receiver>
    </application>

</manifest>