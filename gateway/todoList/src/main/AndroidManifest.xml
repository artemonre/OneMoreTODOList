<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Special app access, not a runtime prompt - canScheduleExactAlarms()/
         ACTION_REQUEST_SCHEDULE_EXACT_ALARM only apply from Android 12 (API 31) onward. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Runtime-prompted on Android 13+ (API 33), normal/auto-granted below that - required to
         actually show a due-time notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AlarmManager alarms are wiped on reboot - this lets BootCompletedReceiver re-arm them. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".TodoListApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:launchMode="singleTop"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QuickAddTodoActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.QuickAddTodo"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".widget.TodoWidgetReceiver"
            android:exported="true"
            android:label="@string/todo_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_info" />
        </receiver>

        <!-- Same TodoWidget, registered again with a smaller default placement size so it shows
             as its own separately pickable entry in the widget picker (see TodoWidgetCompactReceiver). -->
        <receiver
            android:name=".widget.TodoWidgetCompactReceiver"
            android:exported="true"
            android:label="@string/todo_widget_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_compact_info" />
        </receiver>

        <receiver
            android:name=".widget.TodoWidgetRowReceiver"
            android:exported="true"
            android:label="@string/todo_widget_row_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_row_info" />
        </receiver>

        <!-- Fired by AlarmManager via a PendingIntent this app creates itself - not exported, no
             other app can reach it, and the system delivers under our own PendingIntent identity
             regardless. Targeted by an implicit, package-scoped Intent (see
             AndroidAlarmDueTimeScheduler) since app:shared can't reference this gateway-only class. -->
        <receiver
            android:name=".notification.DueTimeAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.artemonre.onemoretodolist.ACTION_TODO_DUE" />
            </intent-filter>
        </receiver>

        <!-- Fired by the notification's "Done" action button, same PendingIntent shape as
             DueTimeAlarmReceiver above. -->
        <receiver
            android:name=".notification.MarkTodoDoneReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.artemonre.onemoretodolist.ACTION_MARK_TODO_DONE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notification.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>